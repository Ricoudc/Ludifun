# Copier en deploy/.env et remplir. Ne jamais versionner ce fichier.

# Nom de domaine de l'API (enregistrement DNS A/AAAA vers le serveur).
LUDIFUN_DOMAIN=api.ludifun.fr

# Secrets : `openssl rand -base64 48` pour chacun.
POSTGRES_PASSWORD=
LUDIFUN_JWT_SECRET=

# IA : claude (défaut), openai, gemini, mistral, groq, xai ou compatible, et la clé correspondante
# (ANTHROPIC_API_KEY, OPENAI_API_KEY, GEMINI_API_KEY, MISTRAL_API_KEY, GROQ_API_KEY, XAI_API_KEY ;
# compatible : LUDIFUN_AI_BASE_URL, LUDIFUN_AI_API_KEY, LUDIFUN_AI_MODEL).
LUDIFUN_AI_PROVIDER=claude
ANTHROPIC_API_KEY=
LUDIFUN_AI_DAILY_BUDGET_USD=20

# E-mails : fournisseur SMTP hébergé dans l'UE (SPF, DKIM et DMARC configurés sur le domaine).
LUDIFUN_SMTP_HOST=
LUDIFUN_SMTP_PORT=587
LUDIFUN_SMTP_USERNAME=
LUDIFUN_SMTP_PASSWORD=
LUDIFUN_EMAIL_FROM=Ludifun <bonjour@ludifun.fr>

# Pages publiques (/confidentialite, /suppression-compte)
LUDIFUN_LEGAL_ENTITY=
LUDIFUN_CONTACT_EMAIL=
LUDIFUN_HOSTING_PROVIDER=
LUDIFUN_EMAIL_PROVIDER=

# Sauvegardes : clé publique age (`age-keygen -o cle-ludifun.txt`, garder la clé privée hors du serveur).
BACKUP_AGE_RECIPIENT=
BACKUP_DIR=./backups
